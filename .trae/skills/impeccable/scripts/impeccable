#!/bin/sh
# Secure fork: only a locally built, explicitly approved engine may run.
set -eu
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bin="${IMPECCABLE_SECURE_BIN:-}"
expected="${IMPECCABLE_SECURE_SHA256:-}"
if [ -z "$bin" ] || [ -z "$expected" ] || [ ! -f "$bin" ] || [ ! -x "$bin" ]; then
  echo "Impeccable Secure: approved local engine and SHA-256 required; no download attempted." >&2
  exit 127
fi
case "$bin" in /*) ;; *) echo "Absolute engine path required" >&2; exit 127;; esac
case "$expected" in *[!0-9a-fA-F]*) exit 127;; esac
[ "${#expected}" -eq 64 ] || exit 127
if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum "$bin"); actual=${actual%% *}
elif command -v shasum >/dev/null 2>&1; then actual=$(shasum -a 256 "$bin"); actual=${actual%% *}
else echo "SHA-256 tool required" >&2; exit 127; fi
[ "$(printf '%s' "$expected" | tr 'A-F' 'a-f')" = "$actual" ] || { echo "Engine checksum mismatch" >&2; exit 127; }
export IMPECCABLE_SKILL_DIR="$dir/.."
export IMPECCABLE_SELF="$dir/impeccable"
exec "$bin" "$@"
